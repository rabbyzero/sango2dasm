000000r 2               ;===============================================================================
000000r 2               ; 6502 CPU Registers and Zero Page Definitions
000000r 2               ;===============================================================================
000000r 2               
000000r 2               ; PPU Registers
000000r 2               PPU_CTRL        = $2000
000000r 2               PPU_MASK        = $2001
000000r 2               PPU_STATUS      = $2002
000000r 2               PPU_OAM_ADDR    = $2003
000000r 2               PPU_OAM_DATA    = $2004
000000r 2               PPU_SCROLL      = $2005
000000r 2               PPU_ADDR        = $2006
000000r 2               PPU_DATA        = $2007
000000r 2               
000000r 2               ; APU and I/O Registers
000000r 2               APU_PULSE1_VOL  = $4000
000000r 2               APU_PULSE1_SWEEP = $4001
000000r 2               APU_PULSE1_LO   = $4002
000000r 2               APU_PULSE1_HI   = $4003
000000r 2               APU_PULSE2_VOL  = $4004
000000r 2               APU_PULSE2_SWEEP = $4005
000000r 2               APU_PULSE2_LO   = $4006
000000r 2               APU_PULSE2_HI   = $4007
000000r 2               APU_TRI_LINEAR  = $4008
000000r 2               APU_TRI_LO      = $400A
000000r 2               APU_TRI_HI      = $400B
000000r 2               APU_NOISE_VOL   = $400C
000000r 2               APU_NOISE_LO    = $400E
000000r 2               APU_NOISE_HI    = $400F
000000r 2               APU_DMC_FREQ    = $4010
000000r 2               APU_DMC_RAW     = $4011
000000r 2               APU_DMC_START   = $4012
000000r 2               APU_DMC_LEN     = $4013
000000r 2               APU_OAM_DMA     = $4014
000000r 2               APU_SND_CHN     = $4015
000000r 2               APU_JOY1        = $4016
000000r 2               APU_JOY2        = $4017
000000r 2               APU_FRAME       = $4017
000000r 2               
000000r 2               ; Namco-163 Registers
000000r 2               NAMCO_IRQ       = $4800
000000r 2               NAMCO_SOUND     = $4800
000000r 2               
000000r 2               ; Namco-163 PRG Bank Switching (mirrors defined in namco163.h)
000000r 2               ; Writing to these addresses switches 8KB PRG banks
000000r 2               PRG_BANK_8000   = $E000
000000r 2               PRG_BANK_A000   = $E800
000000r 2               PRG_BANK_C000   = $F000
000000r 2               
000000r 2               ;===============================================================================
000000r 2               ; PPU Control Bits
000000r 2               ;===============================================================================
000000r 2               PPU_CTRL_NMI        = %10000000  ; Enable NMI
000000r 2               PPU_CTRL_PPM        = %01000000  ; PPU master/slave
000000r 2               PPU_CTRL_SPR_8      = %00000000  ; 8x8 sprites
000000r 2               PPU_CTRL_SPR_16     = %00100000  ; 8x16 sprites
000000r 2               PPU_CTRL_BG_0       = %00000000  ; BG pattern table $0000
000000r 2               PPU_CTRL_BG_1       = %00001000  ; BG pattern table $1000
000000r 2               PPU_CTRL_SPR_0      = %00000000  ; SPR pattern table $0000
000000r 2               PPU_CTRL_SPR_1      = %00000100  ; SPR pattern table $1000
000000r 2               PPU_CTRL_INC_1      = %00000000  ; VRAM address +1
000000r 2               PPU_CTRL_INC_32     = %00000010  ; VRAM address +32
000000r 2               PPU_CTRL_NT_0       = %00000000  ; Nametable $2000
000000r 2               PPU_CTRL_NT_1       = %00000001  ; Nametable $2400
000000r 2               PPU_CTRL_NT_2       = %00000010  ; Nametable $2800
000000r 2               PPU_CTRL_NT_3       = %00000011  ; Nametable $2C00
000000r 2               
000000r 2               ;===============================================================================
000000r 2               ; PPU Mask Bits
000000r 2               ;===============================================================================
000000r 2               PPU_MASK_EMPHASIS_BLUE  = %00100000
000000r 2               PPU_MASK_EMPHASIS_GREEN = %00010000
000000r 2               PPU_MASK_EMPHASIS_RED   = %00001000
000000r 2               PPU_MASK_SPRITES_VISIBLE = %00000100
000000r 2               PPU_MASK_BG_VISIBLE     = %00000010
000000r 2               PPU_MASK_SPRITE_CLIP    = %00000001
000000r 2               PPU_MASK_BG_CLIP        = %00000010
000000r 2               
000000r 2               ;===============================================================================
