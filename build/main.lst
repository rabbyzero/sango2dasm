000000r 2               ;===============================================================================
000000r 2               PPU_STATUS_VBLANK     = %10000000
000000r 2               PPU_STATUS_SPRITE0    = %01000000
000000r 2               PPU_STATUS_OVERFLOW   = %00100000
000000r 2               PPU_STATUS_VRAM_WRITE = %00010000
000000r 2               
000000r 1               .include "namco163.h"
000000r 2               ;===============================================================================
000000r 2               ; Namco-163 Mapper Definitions
000000r 2               ; Sangokushi 2 - Haou no Tairiku uses Namco-163 (Mapper 19)
000000r 2               ;===============================================================================
000000r 2               
000000r 2               ; Namco-163 PRG ROM Configuration
000000r 2               ; Total PRG ROM: 32 banks x 8KB = 256KB
000000r 2               ; Banks are 8KB each, mapped to $8000-$FFFF
000000r 2               
000000r 2               ; Namco-163 CHR Bank Registers (1KB CHR windows for nametable tile banks)
000000r 2               NAMCO_CHR_BANK_0  = $C000  ; CHR bank 0 - NT slot 0
000000r 2               NAMCO_CHR_BANK_1  = $C800  ; CHR bank 1 - NT slot 1
000000r 2               NAMCO_CHR_BANK_2  = $D000  ; CHR bank 2 - NT slot 2
000000r 2               NAMCO_CHR_BANK_3  = $D800  ; CHR bank 3 - NT slot 3
000000r 2               
000000r 2               ; Namco-163 CHR Bank Registers - Primary Set (8 x 1KB pattern table slots)
000000r 2               NAMCO163_CHR_0    = $8000  ; CHR slot 0 -> PPU $0000-$03FF
000000r 2               NAMCO163_CHR_1    = $8800  ; CHR slot 1 -> PPU $0400-$07FF
000000r 2               NAMCO163_CHR_2    = $9000  ; CHR slot 2 -> PPU $0800-$0BFF
000000r 2               NAMCO163_CHR_3    = $9800  ; CHR slot 3 -> PPU $0C00-$0FFF
000000r 2               NAMCO163_CHR_4    = $A000  ; CHR slot 4 -> PPU $1000-$13FF
000000r 2               NAMCO163_CHR_5    = $A800  ; CHR slot 5 -> PPU $1400-$17FF
000000r 2               NAMCO163_CHR_6    = $B000  ; CHR slot 6 -> PPU $1800-$1BFF
000000r 2               NAMCO163_CHR_7    = $B800  ; CHR slot 7 -> PPU $1C00-$1FFF
000000r 2               
000000r 2               ; Namco-163 PRG Bank Switching Registers (8KB PRG windows)
000000r 2               NAMCO_PRG_8000    = $E000  ; Switch PRG bank at $8000-$9FFF
000000r 2               NAMCO_PRG_A000    = $E800  ; Switch PRG bank at $A000-$BFFF (ORA #$C0 to disable CHR-RAM)
000000r 2               NAMCO_PRG_C000    = $F000  ; Switch PRG bank at $C000-$DFFF
000000r 2               NAMCO_PRG_8000_ALT = $F800 ; Alternate/mirror for PRG $8000; also Namco control register
000000r 2               
000000r 2               ; Namco-163 Control Register
000000r 2               NAMCO_CTRL        = $F800  ; Sound/IRQ control (same address as PRG_8000_ALT)
000000r 2               
000000r 2               ; Namco-163 Address/Control Port ($4800)
000000r 2               ; Shared by sound and IRQ subsystems: write register index here first
000000r 2               NAMCO163_ADDR     = $4800  ; Namco-163 register address port
000000r 2               NAMCO_IRQ_COUNTER = $4800  ; IRQ counter (alias)
000000r 2               NAMCO_SOUND_ADDR  = $4800  ; Sound register address (alias)
000000r 2               
000000r 2               ; Namco-163 Data Ports ($5000/$5800)
000000r 2               ; After writing address to $4800, read/write data through these
000000r 2               NAMCO163_DATA_LO  = $5000  ; Data port low byte
000000r 2               NAMCO163_DATA_HI  = $5800  ; Data port high byte
000000r 2               ; Sound aliases
000000r 2               NAMCO_SOUND_DATA_LO = $5000  ; Sound data low byte
000000r 2               NAMCO_SOUND_DATA_HI = $5800  ; Sound data high byte
000000r 2               ; IRQ aliases
000000r 2               NAMCO_IRQ_LO      = $5000  ; IRQ counter low byte
000000r 2               NAMCO_IRQ_HI      = $5800  ; IRQ counter high byte
000000r 2               
000000r 2               ; Number of PRG banks
000000r 2               NUM_PRG_BANKS     = 32
000000r 2               
000000r 2               ; Bank indices
000000r 2               BANK_00           = $00
000000r 2               BANK_01           = $01
000000r 2               BANK_02           = $02
000000r 2               BANK_03           = $03
000000r 2               BANK_04           = $04
000000r 2               BANK_05           = $05
000000r 2               BANK_06           = $06
000000r 2               BANK_07           = $07
000000r 2               BANK_08           = $08
000000r 2               BANK_09           = $09
000000r 2               BANK_0A           = $0A
000000r 2               BANK_0B           = $0B
000000r 2               BANK_0C           = $0C
000000r 2               BANK_0D           = $0D
000000r 2               BANK_0E           = $0E
000000r 2               BANK_0F           = $0F
000000r 2               BANK_10           = $10
000000r 2               BANK_11           = $11
000000r 2               BANK_12           = $12
000000r 2               BANK_13           = $13
000000r 2               BANK_14           = $14
000000r 2               BANK_15           = $15
000000r 2               BANK_16           = $16
000000r 2               BANK_17           = $17
000000r 2               BANK_18           = $18
000000r 2               BANK_19           = $19
000000r 2               BANK_1A           = $1A
000000r 2               BANK_1B           = $1B
000000r 2               BANK_1C           = $1C
000000r 2               BANK_1D           = $1D
000000r 2               BANK_1E           = $1E
000000r 2               BANK_1F           = $1F
000000r 2               
000000r 2               ;===============================================================================
000000r 2               ; Bank Switching Macros
000000r 2               ;===============================================================================
000000r 2               
000000r 2               .macro switch_bank_8000 bank
000000r 2                   LDA #bank
000000r 2                   STA NAMCO_PRG_8000
000000r 2               .endmacro
000000r 2               
000000r 2               .macro switch_bank_A000 bank
000000r 2                   LDA #bank
000000r 2                   STA NAMCO_PRG_A000
000000r 2               .endmacro
000000r 2               
000000r 2               .macro switch_bank_C000 bank
000000r 2                   LDA #bank
000000r 2                   STA NAMCO_PRG_C000
000000r 2               .endmacro
000000r 2               
000000r 2               
000000r 1               
000000r 1               ;===============================================================================
000000r 1               ; Global Variables
000000r 1               ;===============================================================================
000000r 1               
000000r 1               .segment "ZEROPAGE"
000000r 1  xx xx            zp_temp:        .res 2
000002r 1  xx xx            zp_ptr:         .res 2
000004r 1  xx               zp_index:       .res 1
000005r 1               
000005r 1               .segment "BSS"
000000r 1  xx xx xx xx      ram_buffer:     .res 256
000004r 1  xx xx xx xx  
000008r 1  xx xx xx xx  
000100r 1               
000100r 1               ;===============================================================================
000100r 1               ; Code - Bank 0x1F contains reset handler
000100r 1               ;===============================================================================
000100r 1               
000100r 1               .segment "CODE"
000000r 1               
000000r 1               ;-------------------------------------------------------------------------------
000000r 1               ; Reset Handler
000000r 1               ;-------------------------------------------------------------------------------
000000r 1               Reset:
000000r 1  78               SEI
000001r 1  D8               CLD
000002r 1  A2 FF            LDX #$FF
000004r 1  9A               TXS
000005r 1               
000005r 1                   ; Wait for PPU warm-up
000005r 1  A9 03            LDA #3
000007r 1               @waitframes:
000007r 1  2C 02 20         BIT PPU_STATUS
00000Ar 1  D0 FB            BNE @waitframes
00000Cr 1  38               SEC
00000Dr 1  E9 01            SBC #1
00000Fr 1  D0 F6            BNE @waitframes
000011r 1               
000011r 1                   ; Clear RAM
000011r 1  A9 00            LDA #0
000013r 1  A8               TAY
000014r 1  99 00 00     :   STA $0000,Y
000017r 1  99 00 01         STA $0100,Y
00001Ar 1  99 00 03         STA $0300,Y
00001Dr 1  99 00 04         STA $0400,Y
000020r 1  99 00 05         STA $0500,Y
000023r 1  99 00 06         STA $0600,Y
000026r 1  99 00 07         STA $0700,Y
000029r 1  C8               INY
00002Ar 1  D0 E8            BNE :-
00002Cr 1               
00002Cr 1  20 rr rr         JSR PPU_Init
00002Fr 1  20 rr rr         JSR Mapper_Init
000032r 1  4C rr rr         JMP Main
000035r 1               
000035r 1               ;-------------------------------------------------------------------------------
000035r 1               ; NMI Handler
000035r 1               ;-------------------------------------------------------------------------------
000035r 1               NMI:
000035r 1  48               PHA
000036r 1  8A               TXA
000037r 1  48               PHA
000038r 1  98               TYA
000039r 1  48               PHA
00003Ar 1               
00003Ar 1                   ; TODO: VBlank processing
00003Ar 1               
00003Ar 1  68               PLA
00003Br 1  A8               TAY
00003Cr 1  68               PLA
00003Dr 1  AA               TAX
00003Er 1  68               PLA
00003Fr 1  2C 02 20         BIT PPU_STATUS
000042r 1  40               RTI
000043r 1               
000043r 1               ;-------------------------------------------------------------------------------
000043r 1               ; IRQ Handler
000043r 1               ;-------------------------------------------------------------------------------
000043r 1               IRQ:
000043r 1  48               PHA
000044r 1  8A               TXA
000045r 1  48               PHA
000046r 1  98               TYA
000047r 1  48               PHA
000048r 1               
000048r 1                   ; TODO: Handle IRQ
000048r 1               
000048r 1  68               PLA
000049r 1  A8               TAY
00004Ar 1  68               PLA
00004Br 1  AA               TAX
00004Cr 1  68               PLA
00004Dr 1  40               RTI
00004Er 1               
00004Er 1               ;-------------------------------------------------------------------------------
00004Er 1               ; PPU Initialization
00004Er 1               ;-------------------------------------------------------------------------------
00004Er 1               PPU_Init:
00004Er 1  A9 00            LDA #0
000050r 1  8D 00 20         STA PPU_CTRL
000053r 1  8D 01 20         STA PPU_MASK
000056r 1  8D 05 20         STA PPU_SCROLL
000059r 1  8D 05 20         STA PPU_SCROLL
00005Cr 1  60               RTS
00005Dr 1               
00005Dr 1               ;-------------------------------------------------------------------------------
00005Dr 1               ; Namco-163 Mapper Initialization
00005Dr 1               ;-------------------------------------------------------------------------------
00005Dr 1               Mapper_Init:
00005Dr 1  A9 00 8D 00      switch_bank_8000 BANK_00
000061r 1  E0           
000062r 1  A9 01 8D 00      switch_bank_A000 BANK_01
000066r 1  E8           
000067r 1  A9 02 8D 00      switch_bank_C000 BANK_02
00006Br 1  F0           
00006Cr 1  A9 00            LDA #$00
00006Er 1  8D 00 48         STA NAMCO_IRQ_COUNTER
000071r 1  60               RTS
000072r 1               
000072r 1               ;-------------------------------------------------------------------------------
000072r 1               ; Main Entry
000072r 1               ;-------------------------------------------------------------------------------
000072r 1               Main:
000072r 1                   ; TODO: Implement main game loop
000072r 1               Loop:
000072r 1  2C 02 20         BIT PPU_STATUS
000075r 1  10 FB            BPL Loop
000077r 1  4C rr rr         JMP Loop
00007Ar 1               
00007Ar 1               ;===============================================================================
00007Ar 1               ; Interrupt Vectors (at $9FFA in PRG_SLOT0)
00007Ar 1               ;===============================================================================
00007Ar 1               
00007Ar 1               .segment "VECTORS"
000000r 1  rr rr            .addr NMI      ; $9FFA - NMI
000002r 1  rr rr            .addr Reset    ; $9FFC - Reset
000004r 1  rr rr            .addr IRQ      ; $9FFE - IRQ
000004r 1               
