000000r 2               B17_18_PpuWriteTileOffset = $A006   ; Entry02: PPU tile data write with offset
000000r 2               B17_18_DisplayScrollLoop  = $A009   ; Entry03: Display scroll and render loop
000000r 2               B17_18_DisplayAndChrSetup = $A00C   ; Entry04: Display coordinate check + CHR setup
000000r 2               B17_18_BattleEffects      = $A00F   ; Entry05: Battle visual effects
000000r 2               B17_18_BattleDispatch     = $A012   ; Entry06: Battle dispatch
000000r 2               B17_18_OverlayWindow      = $A015   ; Entry07: Overlay/window rendering
000000r 2               B17_18_SetupAdvisorTiles  = $A018   ; Entry08: Setup advisor/council tiles
000000r 2               B17_18_MainGameDispatch   = $A01B   ; Entry09: Main game mode dispatcher
000000r 2               B17_18_DomesticActionDispatch = $A01E ; Entry0A: Domestic action dispatcher
000000r 2               B17_18_AnimationDispatch  = $A021   ; Entry0B: Animation dispatch
000000r 2               B17_18_DomesticDisplay    = $A024   ; Entry0C: Domestic affairs display
000000r 2               B17_18_DataRecordLoader   = $A027   ; Entry0D: Data record loader
