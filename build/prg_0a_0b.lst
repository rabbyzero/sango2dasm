000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B3B_RenderScene           = $A000   ; Scene rendering (NMI context)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $39 - NMI battle
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B39_BattleEffects         = $A00F   ; Battle effects (NMI context)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Banks $17+$18 - Domestic/Kingdom display (combined 16KB $A000-$DFFF)
000000r 2               ; Loaded via SwitchBankAC with Y=$37
000000r 2               ;
000000r 2               ; Jump table entry points ($A000-$A029)
000000r 2               ;-------------------------------------------------------------------------------
