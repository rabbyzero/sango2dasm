000000r 2               B1F_SpriteClearFromIndex  = $E830   ; Clear sprites from X index
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1F: Random Number Generator
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_RandomBelow100        = $E843   ; Random byte < 100
000000r 2               B1F_RandomDiv2            = $E84B   ; Random byte / 2
000000r 2               B1F_RandomModPow2         = $E850   ; Random mod 4/8/16 (entry point)
000000r 2               B1F_RandomMod4            = $E850   ; Random mod 4
000000r 2               B1F_RandomMod8            = $E856   ; Random mod 8
000000r 2               B1F_RandomMod16           = $E85C   ; Random mod 16
000000r 2               B1F_RandomBelowThreshold  = $E862   ; Random below threshold
000000r 2               B1F_RandomByte            = $E87A   ; RNG core: table lookup at $E8BA
000000r 2               B1F_RandomVariants        = $E88A   ; RNG variants (entry point)
000000r 2               B1F_RandomByte2           = $E88A   ; RNG variant 2 ($0052 index)
000000r 2               B1F_RandomByte3           = $E89A   ; RNG variant 3 ($0054 index)
000000r 2               B1F_RandomByte4           = $E8AA   ; RNG variant 4 ($0055 index)
000000r 2               B1F_RandomTable           = $E8BA   ; Pre-computed random data (256 bytes)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1G: Math Routines
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_MathBinToBcd          = $E9BA   ; 24-bit binary to 6-digit packed BCD
000000r 2               B1F_MathDiv16             = $EA7C   ; 16-bit unsigned division (16 iterations)
000000r 2               B1F_MathDiv24             = $EAA5   ; 24-bit unsigned division (24 iterations)
000000r 2               B1F_CallbackDispatcher    = $EADE   ; Inline pointer table callback dispatcher
000000r 2               B1F_ScrollSet             = $EAF7   ; PPU scroll register write
000000r 2               B1F_WindowReset           = $EB1A   ; Window/reset PPU helper ($0250)
000000r 2               B1F_MathBcdToBin          = $EB2D   ; 6-digit packed BCD to 24-bit binary
000000r 2               B1F_MathExtractUpperNibble = $EBB1  ; Extract upper nibble (4x LSR)
000000r 2               B1F_MathAccumulate24      = $EBB6   ; 24-bit accumulate add
000000r 2               B1F_MathMulDiv100         = $EBCA   ; 16-bit * 8-bit / 100
000000r 2               B1F_MathMul24x8           = $EBE9   ; 24x8 multiply (32-bit result)
000000r 2               B1F_MathMul24x16          = $EC22   ; 24x16 multiply (40-bit result)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1H: Palette Animation
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_PaletteAnimation      = $EC67   ; Palette color rotation/animation
000000r 2               B1F_PaletteFadeInit       = $ECBF   ; Palette fade initialization
000000r 2               B1F_PaletteCopyBuffer     = $ECEE   ; Palette copy to buffer
000000r 2               
