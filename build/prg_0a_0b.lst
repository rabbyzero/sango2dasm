000000r 1               ;===============================================================================
000000r 1               ; Global RAM Address Definitions
000000r 1               ;===============================================================================
000000r 1               ; These addresses have consistent meaning across the bank pair.
000000r 1               
000000r 1               ; --- Battery SRAM ($6Fxx) ---
000000r 1               sram_kingdom_index     = $6F02  ; Kingdom/region index
000000r 1               sram_player_id         = $6F03  ; Current player ID / slot
000000r 1               sram_game_start_flag   = $6F8B  ; Game start flag ($FF = new game)
000000r 1               sram_work_0            = $6F5F  ; Computed work value 0
000000r 1               sram_work_1            = $6F60  ; Computed work value 1
000000r 1               sram_work_2            = $6F61  ; Computed work value 2
000000r 1               sram_counter           = $6F5B  ; Iteration counter
000000r 1               
000000r 1               ; --- Work Area ($0036-$0045) ---
000000r 1               work_outer_idx         = $0036  ; Outer loop index
000000r 1               work_inner_idx         = $0037  ; Inner loop index
000000r 1               work_inner_idx2        = $0038  ; Inner loop index 2
000000r 1               work_sub_idx           = $0039  ; Sub-loop index
000000r 1               work_limit_a           = $003A  ; Comparison limit A
000000r 1               work_limit_b           = $003B  ; Comparison limit B
000000r 1               work_temp_0            = $003C  ; Temporary storage 0
000000r 1               work_temp_1            = $003D  ; Temporary storage 1
000000r 1               work_temp_2            = $003E  ; Temporary storage 2
000000r 1               work_record_idx        = $003F  ; Record index
000000r 1               work_record_val        = $0040  ; Record value
000000r 1               work_search_result     = $0041  ; Search/comparison result
000000r 1               work_search_max        = $0045  ; Search max value
000000r 1               
000000r 1               ; --- Math Workspace ($20-$27) ---
000000r 1               math_acc_lo            = $20    ; Accumulator low byte
000000r 1               math_acc_mlo           = $21    ; Accumulator mid-low
000000r 1               math_acc_mhi           = $22    ; Accumulator mid-high
000000r 1               math_acc_hi            = $23    ; Accumulator high byte
000000r 1               math_ext               = $24    ; Extension byte
000000r 1               math_temp1             = $25    ; Math temporary 1
000000r 1               math_temp2             = $26    ; Math temporary 2
000000r 1               math_temp3             = $27    ; Math temporary 3
000000r 1               
000000r 1               ; --- Game State ($05xx) ---
000000r 1               state_sub_dispatch     = $0540  ; Sub-state dispatch index
000000r 1               state_display_idx      = $0541  ; Display state index
000000r 1               state_overlay_param    = $0545  ; Overlay/menu parameter
000000r 1               state_palette_mode     = $0547  ; Palette animation mode
