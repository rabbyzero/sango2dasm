000000r 1               ;===============================================================================
000000r 1               ; PRG Bank $17 - $A000-$BFFF
000000r 1               ; Sangokushi 2 - Haou no Tairiku (J)
000000r 1               ; Namco-163 Mapper 19
000000r 1               ;
000000r 1               ; Paired with bank $18 ($C000-$DFFF). Loaded together via SwitchBankAC_A/B.
000000r 1               ; Y=$37 -> bank $17@$A000, bank $18@$C000
000000r 1               ;===============================================================================
000000r 1               
000000r 1               .include "6502_registers.h"
000000r 2               ;===============================================================================
000000r 2               ; 6502 CPU Registers and Zero Page Definitions
000000r 2               ;===============================================================================
000000r 2               
000000r 2               ; PPU Registers
000000r 2               PPU_CTRL        = $2000
000000r 2               PPU_MASK        = $2001
000000r 2               PPU_STATUS      = $2002
000000r 2               PPU_OAM_ADDR    = $2003
000000r 2               PPU_OAM_DATA    = $2004
000000r 2               PPU_SCROLL      = $2005
000000r 2               PPU_ADDR        = $2006
000000r 2               PPU_DATA        = $2007
000000r 2               
