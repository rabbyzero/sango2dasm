000000r 1               ; Jump Table - Public entry points ($A000-$A029)
000000r 1               ;===============================================================================
000000r 1               B17_Entry00:
000000r 1  4C rr rr       JMP LA087                                           ; $A000: 4C 87 A0
000003r 1               B17_Entry01:
000003r 1  4C rr rr       JMP LA212                                           ; $A003: 4C 12 A2
000006r 1               B17_Entry02:
000006r 1  4C rr rr       JMP LA24E                                           ; $A006: 4C 4E A2
