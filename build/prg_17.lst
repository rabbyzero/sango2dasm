000000r 2               B1F_IrqExit               = $FB9E   ; IRQ exit: restore regs, RTI
000000r 2               B1F_IrqMode1_SoundAndChr  = $FBA4   ; IRQ mode 1: Sound regs + CHR dispatch
000000r 2               B1F_IrqChrUpdate_Block1   = $FBCE   ; CHR update block 1
000000r 2               B1F_IrqChrUpdate_Block2   = $FBFC   ; CHR update block 2
000000r 2               B1F_IrqChrUpdate_Block3   = $FC2A   ; CHR update block 3
000000r 2               B1F_IrqChrUpdate_Block4   = $FC58   ; CHR update block 4
000000r 2               B1F_IrqMode2_FullSetup    = $FC8B   ; IRQ mode 2: Full CHR + sound setup
000000r 2               B1F_ScanlineDelayTable    = $FD1A   ; Scanline delay values
