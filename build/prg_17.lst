000000r 2               APU_SND_CHN     = $4015
000000r 2               APU_JOY1        = $4016
000000r 2               APU_JOY2        = $4017
000000r 2               APU_FRAME       = $4017
000000r 2               
000000r 2               ; Namco-163 Registers
000000r 2               NAMCO_IRQ       = $4800
000000r 2               NAMCO_SOUND     = $4800
000000r 2               
000000r 2               ; Namco-163 PRG Bank Switching (mirrors defined in namco163.h)
000000r 2               ; Writing to these addresses switches 8KB PRG banks
000000r 2               PRG_BANK_8000   = $E000
000000r 2               PRG_BANK_A000   = $E800
000000r 2               PRG_BANK_C000   = $F000
