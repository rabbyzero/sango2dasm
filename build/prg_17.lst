000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1T: Data Tables
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_MetaTileData          = $F477   ; Metatile data / sound+music data
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1U: NMI Handler and Sub-States
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_NmiHandler            = $F800   ; NMI handler (8 sub-states)
000000r 2               B1F_NmiDispatchTable      = $F87B   ; NMI game state dispatch table (9 entries)
000000r 2               B1F_NmiEpilogue           = $F88D   ; Restore PRG banks, tick counters, RTI
000000r 2               B1F_NmiState2_MapScreen   = $F8B5   ; NMI state 2: Map screen rendering
000000r 2               B1F_NmiState3_Battle      = $F8FE   ; NMI state 3: Battle rendering
000000r 2               B1F_NmiState4_Menu        = $F96A   ; NMI state 4: Menu rendering
000000r 2               B1F_NmiState5_Diplomacy   = $F9A0   ; NMI state 5: Diplomacy rendering
000000r 2               B1F_NmiState6_Event       = $F9E4   ; NMI state 6: Event rendering
000000r 2               B1F_NmiState7_Strategy    = $FA13   ; NMI state 7: Strategy rendering
000000r 2               B1F_NmiState8_Officer     = $FA53   ; NMI state 8: Officer rendering
000000r 2               B1F_NmiState0_Idle        = $FA97   ; NMI state 0: Idle/wait
000000r 2               B1F_SwapPlayerPointers    = $FAA9   ; Palette swap (if $6F44!=0)
000000r 2               B1F_RestorePlayerPointers = $FABF   ; Palette swap reverse
000000r 2               B1F_NmiHandler_Busy       = $FAD5   ; NMI busy: scroll mode + CHR restore
000000r 2               B1F_SetupChrBanksAndWait  = $FB0B   ; Setup CHR banks + wait for VBlank
000000r 2               B1F_WaitVBlank            = $FB28   ; Wait for VBlank
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1V: IRQ Handler and Sub-Modes
000000r 2               ;-------------------------------------------------------------------------------
