000000r 1               .include "functions.h"
000000r 2               ;===============================================================================
000000r 2               ; functions.h - Symbolic Function and Data Label Definitions
000000r 2               ; Sangokushi 2 - Haou no Tairiku (J) / Namco-163 (Mapper 19)
000000r 2               ;
000000r 2               ; Defines symbolic names for all known functions and data labels.
000000r 2               ; Include from any .asm file:  .include "functions.h"
000000r 2               ;
000000r 2               ; Naming Convention: BXX_FunctionName
000000r 2               ;   XX = PRG bank number (hex, $00-$1F)
000000r 2               ;   Bank $1F symbols are at fixed addresses $E000-$FFFF
000000r 2               ;   Banked symbols ($8000-$DFFF) share CPU addresses across banks
000000r 2               ;
000000r 2               ; ca65 allows multiple symbols with the same value:
000000r 2               ;   B04_Init = $A000 and B08_Init = $A000 are both valid
000000r 2               ;===============================================================================
000000r 2               
000000r 2               ;===============================================================================
000000r 2               ; SECTION 1: Bank $1F - Fixed Code ($E000-$FFFF)
000000r 2               ; Always mapped to $E000-$FFFF (PRG slot 3)
000000r 2               ;===============================================================================
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1A: Reset and State Machine
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_Reset                 = $E000   ; Reset handler: SEI, CLD, RAM clear, init
000000r 2               B1F_StateDispatch         = $E066   ; Jump to handler via VectorTable[game_state]
000000r 2               B1F_VectorTable           = $E07C   ; State dispatch table (15 entries, 2 bytes each)
000000r 2               B1F_State_SystemInit      = $E09A   ; State 0: System init, PPU setup, -> state 9
000000r 2               B1F_State_NewGameInit     = $E0DA   ; State 1: New game init, SRAM, music $81
000000r 2               B1F_State_RandomDisplay2A = $E17D   ; State 2: Random + display (Y=$2A)
000000r 2               B1F_State_KingdomSelect   = $E18B   ; State 3: Kingdom select, scenario/normal
000000r 2               B1F_State_RandomDisplay28 = $E221   ; State 4: Random + display (Y=$28)
000000r 2               B1F_State_DomesticAffairs = $E22F   ; State 5: Domestic affairs, action select
000000r 2               B1F_DomesticActionLookup  = $E29C   ; Domestic action display by $0544
000000r 2               B1F_DomesticGraphicPtrs   = $E2C2   ; 7 graphic pointers for domestic actions
000000r 2               B1F_DomesticBaseDataPtrs  = $E2D0   ; Base data pointers for domestic display
000000r 2               B1F_DomesticSpriteYPos    = $E2DE   ; Sprite Y position table (4 bytes)
000000r 2               B1F_State_RandomAdvance1  = $E2E2   ; State 6: Pure RNG advance
000000r 2               B1F_State_BattlePhase     = $E2E8   ; State 7: Battle phase, army status
000000r 2               B1F_State_RandomAdvance2  = $E36A   ; State 8: Pure RNG advance
000000r 2               B1F_DisplayInit           = $E370   ; Display init: window clear + bank display
000000r 2               B1F_State_TerritoryView   = $E37C   ; State 9: Territory/map view
000000r 2               B1F_State_IdleWait        = $E3EB   ; State 10/12/14: Idle wait, JMP dispatch
000000r 2               B1F_State_AdvisorCouncil  = $E3EE   ; State 11: Advisor/council dialogue
000000r 2               B1F_State_TurnSummary     = $E46A   ; State 13: Turn summary/report
000000r 2               B1F_FrameInit             = $E4DA   ; Per-frame setup: PPU, bank, clear RAM
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1B: Bank Switching
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_BankSwitch            = $E51F   ; 8-byte config bank switch (CHR + ext)
000000r 2               B1F_BankSwitchTable       = $E567   ; Bank switch config table (3 x 8 bytes)
000000r 2               B1F_BankPpuInit           = $E57F   ; Bank + PPU init + JMP patch
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1C: Sound Engine
000000r 2               ;-------------------------------------------------------------------------------
