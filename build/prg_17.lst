000000r 2               B1F_IrqMode6_Minimal      = $FDF4   ; IRQ mode 6: Minimal update
000000r 2               B1F_IrqMode7_SoundChr     = $FE03   ; IRQ mode 7: Sound + CHR update
000000r 2               B1F_IrqMode8_SoundChr     = $FE69   ; IRQ mode 8: Sound + CHR update
000000r 2               B1F_IrqMode9_BasicChr     = $FE96   ; IRQ mode 9: Basic CHR update
000000r 2               B1F_IrqMode10_PpuScroll   = $FECD   ; IRQ mode 10: PPU scroll update
000000r 2               B1F_IrqMode11_ScrollFwd   = $FF31   ; IRQ mode 11: Scroll forward
