000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; 1W: Scroll Calculation
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B1F_CalcScrollAddr        = $FF62   ; Scroll calc: $009A/$009B from $0098
000000r 2               B1F_CalcScrollAddrAlt     = $FF9B   ; Scroll calc variant B
000000r 2               
000000r 2               ;===============================================================================
000000r 2               ; SECTION 2: Banked Entry Points ($A000-$BFFF)
000000r 2               ;
000000r 2               ; These addresses are called after PRG bank switching via SwitchBankAC_B/A.
000000r 2               ; The same CPU address maps to different code depending on the active PRG bank.
000000r 2               ; The $A000 slot maps to Namco-163 PRG bank Y; $C000 maps to bank Y+1.
000000r 2               ;
000000r 2               ; Bank numbers below are the Y register values passed to SwitchBankAC_B
000000r 2               ; before each call.
000000r 2               ;===============================================================================
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $3D - Primary display/gameplay bank
000000r 2               ; Called from state handlers (default) and NMI sub-dispatch
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B3D_RenderScene           = $A000   ; Scene rendering (generic display)
000000r 2               B3D_RenderMap             = $A003   ; Map/battle/UI rendering (most common)
000000r 2               B3D_ScenarioAction        = $A006   ; Scenario/action display
000000r 2               B3D_InputAndRender        = $A009   ; Input handling + render pass
000000r 2               B3D_WeatherEffects        = $A00C   ; Weather/battle effects (NMI dispatch)
000000r 2               B3D_BattleEffects         = $A00F   ; Battle effects processing (NMI dispatch)
000000r 2               B3D_BattleDispatch        = $A012   ; Battle dispatch (NMI dispatch)
000000r 2               B3D_OverlayDisplay        = $A015   ; Overlay/window display
000000r 2               B3D_AdvisorDialogue       = $A018   ; Advisor dialogue rendering
000000r 2               B3D_DisplayAndChrSetup    = $A01B   ; Display + CHR setup (from DisplayInit)
000000r 2               B3D_OfficerManagement     = $A01E   ; Officer management display
000000r 2               B3D_DomesticDisplay       = $A024   ; Domestic affairs display
000000r 2               B3D_KingdomDisplay        = $A027   ; Kingdom select display
000000r 2               B3D_TurnSummaryExtra      = $A03F   ; Turn summary extra rendering
000000r 2               B3D_BankedPaletteUpload   = $A045   ; Banked palette upload variant
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $3B - NMI rendering
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B3B_RenderScene           = $A000   ; Scene rendering (NMI context)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $39 - NMI battle
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B39_BattleEffects         = $A00F   ; Battle effects (NMI context)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $37 - NMI battle/diplomacy rendering
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B37_WeatherEffects        = $A00C   ; Weather rendering in battle
000000r 2               B37_BattleProcess         = $A00F   ; Battle processing
000000r 2               B37_DiplomacyRender       = $A01B   ; Diplomacy screen rendering
000000r 2               B37_OfficerDisplay        = $A01E   ; Officer display
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $2E - NMI rendering
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B2E_RenderScene           = $A000   ; Scene rendering (NMI context)
000000r 2               B2E_RenderMap             = $A003   ; Map rendering (NMI context)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $2C - NMI rendering
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B2C_RenderScene           = $A000   ; Scene rendering (NMI context)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $2A - NMI rendering
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B2A_RenderMap             = $A003   ; Map rendering (NMI context)
000000r 2               
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               ; Bank $28 - NMI domestic
000000r 2               ;-------------------------------------------------------------------------------
000000r 2               B28_DomesticDisplay       = $A024   ; Domestic display (NMI context)
000000r 2               
000000r 2               ;===============================================================================
000000r 2               ; SECTION 3: Banked Code at $8000-$9FFF (Slot 0)
000000r 2               ; Banks switched via SwitchBank8_B ($F25F) or SwitchBank8_A ($F266)
000000r 2               ; TODO: No banked JSR/JMP calls to $8000-$9FFF found in bank $1F yet
000000r 2               ;===============================================================================
000000r 2               ; Template for future use:
000000r 2               ; B00_FunctionName        = $8000
000000r 2               
000000r 2               ;===============================================================================
000000r 2               ; SECTION 4: Banked Code at $C000-$DFFF (Slot 2)
000000r 2               ; Banks paired with $A000 slot via SwitchBankAC_B/SwitchBankAC_A
000000r 2               ; (bank at $C000 is always Y+1 when $A000 is Y)
000000r 2               ; TODO: No direct JSR/JMP calls to $C000-$DFFF found in bank $1F yet
000000r 2               ;===============================================================================
000000r 2               ; Template for future use:
000000r 2               ; B00_FunctionName        = $C000
000000r 2               
