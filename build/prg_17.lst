000000r 2               B1F_PaletteUpload         = $E70E   ; Upload palette $0100-$011F to PPU
000000r 2               B1F_PpuMaskEnable         = $E749   ; PPU mask: enable rendering ($1E)
000000r 2               B1F_PpuMaskDisable        = $E74D   ; PPU mask: disable rendering ($00)
